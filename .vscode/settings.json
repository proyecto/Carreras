{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.git/fsmonitor*": true,
    "**/scratch/**": true,
    "**/cars/models/**": true,
    "**/*.glb": true
  },
  "search.exclude": {
    "**/scratch": true,
    "**/cars/models": true,
    "**/*.glb": true
  },
  "files.exclude": {
    "**/.DS_Store": true
  },
  "git.autorefresh": true,
  "git.enableSmartCommit": true
}
